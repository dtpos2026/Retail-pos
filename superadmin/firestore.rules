rules_version = '2';

// Retail POS — Super Admin security rules.
//  * Head admin: digitaltarget.digital@gmail.com (email must be verified)
//  * Extra admins: documents in /admins/{email} with active == true (managed by head only)
//  * /licenseStatus/{licenseId} is readable by anyone who knows the (random) id so the
//    offline POS can pick up renewals / revocations when it happens to be online.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isHead() {
      return verifiedEmail() && request.auth.token.email == 'digitaltarget.digital@gmail.com';
    }
    function isAdmin() {
      return isHead() || (
        verifiedEmail()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true
      );
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /licenses/{licenseId} {
      allow read, create, update: if isAdmin();
      allow delete: if isHead();
    }

    // Public status page of a license, read by the offline POS when it happens to be online.
    // A POS may only bump `deviceCount` by 1 (while below `maxDevices`) in the same batch that creates
    // its own device document — that is how "one license = N devices" is enforced without a server.
    match /licenseStatus/{licenseId} {
      allow get: if true;          // single-document read by id (POS online check)
      allow list: if isAdmin();    // no public enumeration
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceCount', 'lastDevice'])
        && request.resource.data.deviceCount == resource.data.deviceCount + 1
        && request.resource.data.deviceCount <= resource.data.maxDevices
        && request.resource.data.lastDevice is string
        && !exists(/databases/$(database)/documents/devices/$(licenseId + '_' + request.resource.data.lastDevice))
        && existsAfter(/databases/$(database)/documents/devices/$(licenseId + '_' + request.resource.data.lastDevice))
      );
    }

    // One document per registered computer: id = {licenseId}_{machineId}.
    match /devices/{deviceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['licenseId', 'machineId', 'name', 'os', 'appVersion', 'status', 'businessName', 'firstSeen', 'lastSeen'])
        && deviceId == request.resource.data.licenseId + '_' + request.resource.data.machineId
        && request.resource.data.status == 'active'
        && request.resource.data.firstSeen is timestamp
        && request.resource.data.lastSeen is timestamp
        && get(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.deviceCount
             == get(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.deviceCount + 1
        && getAfter(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.deviceCount
             <= get(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.maxDevices
        && getAfter(/databases/$(database)/documents/licenseStatus/$(request.resource.data.licenseId)).data.lastDevice == request.resource.data.machineId
      );
      // Heartbeat from the POS: only descriptive fields + lastSeen; it can never change its own status.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'os', 'appVersion', 'lastSeen'])
        && request.resource.data.lastSeen is timestamp
      );
      allow delete: if isAdmin();
    }

    // Signing key pair. Private key is readable by admins only.
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isHead();
    }

    // Public half of the signing key. Installed POS builds download it once, so nothing has to be pasted
    // into the app. Only the head admin can publish it; it contains no secret.
    match /publicConfig/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isHead();
    }

    // ---- Support: one thread per license (the license id is an unguessable random id). -------------
    // The shop's POS can read its own thread and post notes ("from == 'shop'"); only admins answer / delete.
    match /supportThreads/{licenseId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['businessName', 'lastText', 'lastAt', 'unreadAdmin'])
        && request.resource.data.unreadAdmin == true
        && request.resource.data.lastText is string
        && request.resource.data.lastText.size() < 300
        && exists(/databases/$(database)/documents/licenseStatus/$(licenseId))
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isAdmin() || (
          request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'businessName'])
          && request.resource.data.from == 'shop'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 2000
          && request.resource.data.createdAt is timestamp
        );
        allow update, delete: if isAdmin();
      }
    }

    // ---- Billing (Digital Target's own invoices) — staff only, plus the public verification record. ----
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }
    match /billingProfile/{docId} {
      allow read, write: if isAdmin();
    }
    // What an invoice QR opens: one record per random code. Anyone holding the code can read that one record.
    match /invoiceVerify/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isHead();
    }

    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
