{
  "name": "retail-pos",
  "productName": "DT Retail POS",
  "version": "1.2.0",
  "description": "Retail POS — Simple Offline POS for Small Businesses",
  "author": {
    "name": "Digital Target",
    "email": "digitaltarget.digital@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test --no-warnings tests/*.test.js",
    "test:e2e": "node tests/e2e.js",
    "dist": "vite build && electron-builder --win nsis --x64",
    "dist:portable": "vite build && electron-builder --win portable --x64",
    "dist:zip": "vite build && electron-builder --win zip --x64",
    "dist:dir": "vite build && electron-builder --win dir --x64",
    "make-icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "digital.digitaltarget.retailpos",
    "productName": "DT Retail POS",
    "copyright": "Copyright © 2026 Digital Target",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "dist-renderer/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RetailPOS-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DT Retail POS",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "RetailPOS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RetailPOS-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
